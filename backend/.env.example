DATABASE_URL=postgresql+asyncpg://revleak:revleak@localhost:5432/revleak
PAGESPEED_API_KEY=
ANTHROPIC_API_KEY=
SERANKING_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
OPERATOR_API_KEY=
APP_ENV=development
SCRAPER_MAX_PAGES=15
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_CONCURRENCY=5
CORS_ORIGINS=["http://localhost:3000","https://revenue-leak-scanner-beta.vercel.app"]
COMPETITOR_CONCURRENCY=2
COMPETITOR_MEASURE_LIMIT=8
COMPETITOR_SCRAPER_MAX_PAGES=6
COMPETITOR_DOMAIN_TIMEOUT_S=180
COMPETITOR_SNAPSHOT_TTL_DAYS=14
COMPETITOR_SNAPSHOT_NEGATIVE_TTL_DAYS=2
FIX_AGENT_MODEL=claude-opus-5
FIX_AGENT_MAX_TURNS=15
TOKEN_ENCRYPTION_KEY=
SHOPIFY_ADMIN_API_VERSION=2026-10

# Finding-verifier: checks priced findings on the live store before euros are final.
VERIFIER_ENABLED=true
# VERIFIER_MODEL=  (defaults to FIX_AGENT_MODEL)
VERIFIER_MAX_TURNS=12

# Funnel agent: mobile browser walk during every full audit (needs `playwright install chromium`).
FUNNEL_AGENT_ENABLED=true
FUNNEL_AGENT_MODEL=claude-sonnet-5
FUNNEL_AGENT_MAX_TURNS=40
FUNNEL_AGENT_TIMEOUT_S=300
