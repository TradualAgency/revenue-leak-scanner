# Base URL of the API. Empty means same-origin (the Vite dev proxy handles /api).
VITE_API_URL=

# NOTE: there is deliberately no operator key here. Anything prefixed VITE_ is
# substituted into the client bundle at build time and served to every visitor — the
# operator key used to live here and ended up verbatim in build/client/assets/api-*.js.
# It is now entered at runtime and kept in sessionStorage; see app/lib/operatorKey.ts.
